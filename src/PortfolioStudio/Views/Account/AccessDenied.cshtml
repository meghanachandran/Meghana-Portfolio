@{
    ViewData["Title"] = "Access Denied";
}

<section class="py-5">
    <div class="container py-5 text-center">
        <div class="surface-card p-5 mx-auto" style="max-width: 520px;">
            <i class="bi bi-shield-exclamation fs-1 text-danger mb-3 d-block"></i>
            <h1 class="h4 fw-bold mb-2">Access Restricted</h1>
            <p class="text-muted-custom mb-4">You must be signed in as an authorized administrator to access this area.</p>
            <div class="d-flex justify-content-center gap-2">
                <a asp-controller="Account" asp-action="Login" class="btn btn-accent px-4">Sign In</a>
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-glass px-4">Public Home</a>
            </div>
        </div>
    </div>
</section>
