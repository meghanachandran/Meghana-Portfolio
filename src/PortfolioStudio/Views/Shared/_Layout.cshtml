<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? $"{ViewData["Title"]} | Meghana Chandran" : "Meghana Chandran — ASP.NET Full Stack Developer")</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header sticky-top">
        <nav class="navbar navbar-expand-lg py-3">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2 fw-bold" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark font-mono">MC</span>
                    <span>Meghana <span class="text-accent">Chandran</span></span>
                </a>

                <div class="d-flex align-items-center gap-2 order-lg-3">
                    <button type="button" id="themeToggle" class="btn btn-icon" aria-label="Toggle color theme" title="Switch Light/Dark Theme">
                        <i class="bi bi-sun-fill theme-icon-light"></i>
                        <i class="bi bi-moon-stars-fill theme-icon-dark"></i>
                    </button>

                    @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
                    {
                        <a asp-controller="Admin" asp-action="Index" class="btn btn-accent btn-sm px-3 d-none d-sm-inline-flex align-items-center gap-1">
                            <i class="bi bi-speedometer2"></i> Admin Panel
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-glass btn-sm px-3 d-none d-sm-inline-flex align-items-center gap-1">
                            <i class="bi bi-shield-lock"></i> Admin
                        </a>
                    }

                    <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                        <i class="bi bi-list fs-3"></i>
                    </button>
                </div>

                <div class="collapse navbar-collapse order-lg-2" id="mainNav">
                    <ul class="navbar-nav mx-auto gap-lg-2 mt-3 mt-lg-0">
                        <li class="nav-item"><a class="nav-link" href="/#hero">Home</a></li>
                        <li class="nav-item"><a class="nav-link" href="/#about">About</a></li>
                        <li class="nav-item"><a class="nav-link" href="/#services">Services</a></li>
                        <li class="nav-item"><a class="nav-link" href="/#portfolio">Projects</a></li>
                        <li class="nav-item"><a class="nav-link" href="/#contact">Contact</a></li>
                        <li class="nav-item d-sm-none mt-2">
                            @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
                            {
                                <a asp-controller="Admin" asp-action="Index" class="btn btn-accent w-100">Admin Panel</a>
                            }
                            else
                            {
                                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-glass w-100">Admin Sign In</a>
                            }
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="site-footer py-4 mt-5">
        <div class="container">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
                <div class="d-flex align-items-center gap-2">
                    <span class="brand-mark brand-mark-sm font-mono">MC</span>
                    <span class="text-muted-custom small">&copy; @DateTime.UtcNow.Year Meghana Chandran &bull; Thrissur, Kerala &bull; Built with ASP.NET Core MVC</span>
                </div>
                <div class="d-flex align-items-center gap-3 small">
                    <a href="/#about" class="footer-link">About</a>
                    <a href="/#services" class="footer-link">Services</a>
                    <a href="/#portfolio" class="footer-link">Projects</a>
                    <a asp-controller="Account" asp-action="Login" class="footer-link">Admin Login</a>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
