@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
}
<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? $"{ViewData["Title"]} — Admin" : "Admin Dashboard") | Meghana Chandran</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script>
        (function () {
            function verifySession() {
                document.documentElement.style.visibility = "hidden";
                fetch("/Account/SessionStatus", { cache: "no-store", credentials: "same-origin" })
                    .then(function (res) { return res.ok ? res.json() : { authenticated: false }; })
                    .then(function (data) {
                        if (!data || !data.authenticated) {
                            window.location.replace("/Account/Login");
                        } else {
                            document.documentElement.style.visibility = "";
                        }
                    })
                    .catch(function () {
                        window.location.replace("/Account/Login");
                    });
            }

            window.addEventListener("pageshow", function (event) {
                var navEntries = performance.getEntriesByType ? performance.getEntriesByType("navigation") : [];
                var navType = navEntries.length > 0 ? navEntries[0].type : "";
                if (event.persisted || navType === "back_forward") {
                    verifySession();
                }
            });
        })();
    </script>
</head>
<body class="admin-body">
    <div class="admin-wrapper">
        <aside class="admin-sidebar offcanvas-lg offcanvas-start" tabindex="-1" id="adminSidebar">
            <div class="p-4 border-bottom border-subtle d-flex align-items-center justify-content-between">
                <a asp-controller="Admin" asp-action="Index" class="text-decoration-none d-flex align-items-center gap-2 fw-bold text-main">
                    <span class="brand-mark font-mono">MC</span>
                    <span>Meghana <span class="text-accent">Admin</span></span>
                </a>
                <button type="button" class="btn-close d-lg-none" data-bs-dismiss="offcanvas" data-bs-target="#adminSidebar"></button>
            </div>

            <nav class="p-3 flex-grow-1 d-flex flex-column gap-1">
                <span class="admin-nav-label">Dashboard</span>
                <a asp-controller="Admin" asp-action="Index" class="admin-nav-link @(currentAction == "Index" ? "active" : "")">
                    <i class="bi bi-grid-1x2"></i> Overview
                </a>

                <span class="admin-nav-label mt-3">Content Management</span>
                <a asp-controller="Admin" asp-action="Projects" class="admin-nav-link @(currentAction is "Projects" or "CreateProject" or "EditProject" ? "active" : "")">
                    <i class="bi bi-kanban"></i> Projects &amp; Case Studies
                </a>
                <a asp-controller="Admin" asp-action="Categories" class="admin-nav-link @(currentAction == "Categories" ? "active" : "")">
                    <i class="bi bi-tags"></i> Categories
                </a>
                <a asp-controller="Admin" asp-action="Services" class="admin-nav-link @(currentAction == "Services" ? "active" : "")">
                    <i class="bi bi-layers"></i> Services
                </a>
                <a asp-controller="Admin" asp-action="Profile" class="admin-nav-link @(currentAction == "Profile" ? "active" : "")">
                    <i class="bi bi-person-badge"></i> Site Profile &amp; About
                </a>

                <span class="admin-nav-label mt-3">Communication &amp; Auth</span>
                <a asp-controller="Admin" asp-action="Messages" class="admin-nav-link @(currentAction == "Messages" ? "active" : "")">
                    <i class="bi bi-envelope"></i> Contact Inbox
                </a>
                <a asp-controller="Admin" asp-action="Security" class="admin-nav-link @(currentAction == "Security" ? "active" : "")">
                    <i class="bi bi-shield-lock"></i> Account Security
                </a>
            </nav>

            <div class="p-3 border-top border-subtle d-flex flex-column gap-2">
                <a asp-controller="Home" asp-action="Index" target="_blank" class="btn btn-outline-glass btn-sm w-100 d-flex align-items-center justify-content-center gap-2">
                    <i class="bi bi-box-arrow-up-right"></i> View Public Site
                </a>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger-soft btn-sm w-100 d-flex align-items-center justify-content-center gap-2">
                        <i class="bi bi-box-arrow-right"></i> Sign Out
                    </button>
                </form>
            </div>
        </aside>

        <div class="admin-main flex-grow-1 min-w-0">
            <header class="admin-topbar px-4 py-3 d-flex align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-3">
                    <button class="btn btn-outline-glass btn-sm d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#adminSidebar">
                        <i class="bi bi-list fs-5"></i>
                    </button>
                    <div>
                        <h1 class="h5 mb-0 fw-bold">@ViewData["Title"]</h1>
                        <small class="text-muted-custom">Signed in as @User.Identity?.Name</small>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button type="button" id="themeToggle" class="btn btn-icon" aria-label="Toggle theme">
                        <i class="bi bi-sun-fill theme-icon-light"></i>
                        <i class="bi bi-moon-stars-fill theme-icon-dark"></i>
                    </button>
                    <a asp-controller="Admin" asp-action="CreateProject" class="btn btn-accent btn-sm px-3">
                        <i class="bi bi-plus-lg"></i> <span class="d-none d-sm-inline">New Project</span>
                    </a>
                </div>
            </header>

            <div class="p-4">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success-custom alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert">
                        <i class="bi bi-check-circle-fill"></i>
                        <div>@TempData["Success"]</div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger-custom alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <div>@TempData["Error"]</div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @RenderBody()
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
