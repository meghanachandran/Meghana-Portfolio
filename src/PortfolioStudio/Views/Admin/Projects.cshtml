@model List<Project>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Projects & Case Studies";
    var categories = ViewBag.Categories as List<Category> ?? new();
    var search = ViewBag.Search as string;
    var selectedCategoryId = ViewBag.CategoryId as int?;
    var status = ViewBag.Status as string;
}

<div class="surface-card p-4 mb-4">
    <form method="get" asp-action="Projects" class="row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label small text-muted-custom mb-1">Search</label>
            <input type="text" name="search" value="@search" class="form-control form-control-custom form-control-sm" placeholder="Title, description, or tech stack..." />
        </div>
        <div class="col-md-3">
            <label class="form-label small text-muted-custom mb-1">Category</label>
            <select name="categoryId" class="form-select form-select-custom form-select-sm">
                <option value="">All Categories</option>
                @foreach (var cat in categories)
                {
                    <option value="@cat.CategoryId" selected="@(selectedCategoryId == cat.CategoryId)">@cat.Name</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label small text-muted-custom mb-1">Status</label>
            <select name="status" class="form-select form-select-custom form-select-sm">
                <option value="" selected="@string.IsNullOrEmpty(status)">All Statuses</option>
                <option value="published" selected="@(status == "published")">Published</option>
                <option value="draft" selected="@(status == "draft")">Drafts</option>
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-accent btn-sm w-100">Filter</button>
            <a asp-action="Projects" class="btn btn-outline-glass btn-sm">Reset</a>
        </div>
    </form>
</div>

<div class="surface-card p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h6 fw-bold mb-0">@Model.Count Project(s)</h2>
        <a asp-action="CreateProject" class="btn btn-accent btn-sm px-3">
            <i class="bi bi-plus-lg me-1"></i> Add Case Study
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <p class="text-muted-custom mb-3">No matching projects found.</p>
            <a asp-action="CreateProject" class="btn btn-accent btn-sm">Create Your First Project</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-custom align-middle mb-0">
                <thead>
                    <tr>
                        <th>Project</th>
                        <th>Category</th>
                        <th>Status</th>
                        <th>Gallery</th>
                        <th>Updated</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <img src="@p.ThumbnailUrl" alt="@p.Title" class="rounded-3 border border-subtle" style="width:68px;height:48px;object-fit:cover;" />
                                    <div>
                                        <div class="fw-semibold">
                                            @p.Title
                                            @if (p.IsFeatured)
                                            {
                                                <i class="bi bi-star-fill text-warning ms-1" title="Featured"></i>
                                            }
                                        </div>
                                        <div class="small text-muted-custom font-mono">/portfolio/@p.Slug</div>
                                    </div>
                                </div>
                            </td>
                            <td class="small">@(p.Category?.Name ?? "-")</td>
                            <td>
                                <span class="badge rounded-pill @(p.IsPublished ? "badge-published" : "badge-draft")">
                                    @(p.IsPublished ? "Published" : "Draft")
                                </span>
                            </td>
                            <td class="small text-muted-custom">@p.Images.Count image(s)</td>
                            <td class="small text-muted-custom">@p.UpdatedAt.ToString("MMM dd, yyyy")</td>
                            <td class="text-end">
                                <div class="d-inline-flex flex-wrap justify-content-end gap-1">
                                    <a asp-controller="Home" asp-action="ProjectDetail" asp-route-slug="@p.Slug" target="_blank" class="btn btn-outline-glass btn-sm" title="Preview">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <form asp-action="TogglePublish" asp-route-id="@p.ProjectId" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-glass btn-sm" title="@(p.IsPublished ? "Unpublish" : "Publish")">
                                            <i class="bi @(p.IsPublished ? "bi-cloud-slash text-warning" : "bi-cloud-check text-success")"></i>
                                        </button>
                                    </form>
                                    <a asp-action="EditProject" asp-route-id="@p.ProjectId" class="btn btn-outline-glass btn-sm" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="DeleteProject" asp-route-id="@p.ProjectId" method="post" class="d-inline" onsubmit="return confirm('Delete project &quot;@p.Title&quot; permanently?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-danger-soft btn-sm" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
