@model List<ContactMessage>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Contact Inbox";
}

<div class="surface-card p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="h6 fw-bold mb-0">Submitted Inquiries (@Model.Count)</h2>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-envelope-open fs-1 text-accent mb-2 d-block"></i>
            <p class="text-muted-custom mb-0">No messages have been submitted yet.</p>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-3">
            @foreach (var msg in Model)
            {
                <div class="p-4 rounded-4" style="background: var(--bg-elevated); border: 1px solid @(msg.IsRead ? "var(--border-subtle)" : "var(--accent)");">
                    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
                        <div>
                            <div class="d-flex align-items-center gap-2">
                                <strong class="h6 mb-0 fw-bold">@msg.Subject</strong>
                                @if (!msg.IsRead)
                                {
                                    <span class="badge bg-info text-dark">Unread</span>
                                }
                            </div>
                            <div class="small text-muted-custom mt-1">
                                From <strong class="text-main">@msg.SenderName</strong> (&lt;<a href="mailto:@msg.SenderEmail" class="text-accent text-decoration-none">@msg.SenderEmail</a>&gt;)
                                &bull; @msg.SubmittedAt.ToString("MMM dd, yyyy HH:mm") UTC
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <form asp-action="ToggleMessageRead" asp-route-id="@msg.MessageId" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-glass btn-sm">
                                    @(msg.IsRead ? "Mark Unread" : "Mark Read")
                                </button>
                            </form>
                            <form asp-action="DeleteMessage" asp-route-id="@msg.MessageId" method="post" class="d-inline" onsubmit="return confirm('Delete this message?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-danger-soft btn-sm"><i class="bi bi-trash"></i></button>
                            </form>
                        </div>
                    </div>
                    <p class="mb-0 small lh-lg" style="white-space: pre-line;">@msg.MessageBody</p>
                </div>
            }
        </div>
    }
</div>
